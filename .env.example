# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# PostgreSQL
# Development tanpa install: jalankan `bun run db:local` di terminal lain.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketara

# Auth
SESSION_TTL_DAYS=7

# Seed admin (optional, used by `bun run db:seed`)
SEED_ADMIN_EMAIL=admin@marketara.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NAME=Platform Admin
