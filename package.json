{
  "name": "marketara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:setup": "bun src/db/migrate.ts && bun src/db/seed.ts",
    "db:local": "bun scripts/local-pg.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/db/seed.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.7.0-beta.19",
    "typescript": "^5.9.3"
  }
}
